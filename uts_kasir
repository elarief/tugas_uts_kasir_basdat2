<?php
// Koneksi ke database
$conn = new mysqli("localhost", "root", "", "db_penjualan_uts");

// Mengecek apakah tombol 'Proses Checkout' ditekan
if(isset($_POST['beli'])) {
    $id_barang = $_POST['id_barang'];
    $jumlah = $_POST['jumlah'];
    
    // Aplikasi memanggil Stored Procedure untuk checkout
    $sql = "CALL sp_CheckoutBarang($id_barang, $jumlah)";
    
    if($conn->query($sql) === TRUE) {
        echo "<div style='background-color:#d4edda; color:#155724; padding:10px; border-radius:5px;'>
              <b>Transaksi Berhasil!</b> Cek stok di database, pasti otomatis berkurang.</div><br>";
    } else {
        echo "<div style='background-color:#f8d7da; color:#721c24; padding:10px; border-radius:5px;'>
              <b>Transaksi Gagal!</b> Pastikan stok barang mencukupi.</div><br>";
    }
}
?>

